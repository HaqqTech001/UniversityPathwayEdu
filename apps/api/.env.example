PORT=4000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
ENABLE_DEV_TOKENS=false

# Express transactional mail (server only)
MAIL_PROVIDER=gmail
MAIL_FROM=youraddress@gmail.com
MAIL_FROM_NAME=University Pathway Educational Consult
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=replace_with_google_app_password

# For Resend SMTP later: MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASSWORD=replace_with_resend_api_key

# Required for backend-managed OTP (32+ random characters)
OTP_SECRET=replace_with_a_distinct_32_character_random_secret
AUTH_PASSWORD_PEPPER=replace_with_another_long_random_secret
